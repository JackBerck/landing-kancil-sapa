{
	"name": "kancil-sapa-landing",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.0.9",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"faq:doc": "node scripts/faq-from-doc.mjs",
		"faq:sync": "node scripts/faq-from-laravel.mjs",
		"assets": "node scripts/make-assets.mjs",
		"lint:design": "node ~/.agents/skills/hallmark/scripts/sloplint.mjs src/routes/app.css src/lib/styles --genre editorial",
		"test:build": "node scripts/check-build.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/qrcode": "^1.5.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.65.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"puppeteer-core": "^25.17.0",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"qrcode": "^1.5.4"
	}
}
